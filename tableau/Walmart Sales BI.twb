      <column caption='walmart_sales_analitico_br.csv' datatype='table' name='[__tableau_internal_object_id__].[walmart_sales_analitico_br.csv_147B7176C0C8441FB97E8E9A5A04EA08]' role='measure' type='quantitative' />
      <column caption="Vendas médias por semana" datatype='real' name='[Calculation_1911202600000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Weekly_Sales]) / COUNTD([Date])" />
      </column>
      <column caption="Feriado" datatype='string' name='[Calculation_1911202600000002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsHoliday] AND MONTH([Date]) = 2 THEN "Super Bowl"&#10;ELSEIF [IsHoliday] AND MONTH([Date]) = 9 THEN "Labor Day"&#10;ELSEIF [IsHoliday] AND MONTH([Date]) = 11 THEN "Thanksgiving"&#10;ELSEIF [IsHoliday] AND MONTH([Date]) = 12 THEN "Natal (semana de 31/12)"&#10;ELSEIF MONTH([Date]) = 12 AND DAY([Date]) &gt;= 18 AND DAY([Date]) &lt;= 24 THEN "Semana antes do Natal (não marcada)"&#10;ELSE "Semana comum" END' />
      </column>
      <column caption="Média semanal da loja" datatype='real' name='[Calculation_1911202600000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="{ FIXED [Store] : SUM([Weekly_Sales]) / COUNTD([Date]) }" />
      </column>
      <column caption="Vendas vs. média da loja" datatype='real' name='[Calculation_1911202600000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([Weekly_Sales]) / AVG([Calculation_1911202600000003]) - 1" />
      </column>
      <column caption="Tamanho da loja (m²)" datatype='real' name='[Calculation_1911202600000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula="[Size] * 0.092903" />
      </column>
